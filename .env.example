# ═══════════════════════════════════════════════════════════════
# PRAXIS v2.0 — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════
# Copy to .env and fill in your values. Never commit .env.

# ── Application ─────────────────────────────────────────────────
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# ── Umans Inference API ────────────────────────────────────────
UMANS_API_KEY=your_umans_api_key_here
UMANS_BASE_URL=https://api.umans.ai/v1

# Model context windows (tokens)
# GLM-5.2 adjusted to 1,000,000 token context per project requirement
UMANS_GLM_CONTEXT_WINDOW=1000000
UMANS_KIMI_CONTEXT_WINDOW=131072
UMANS_QWEN_CONTEXT_WINDOW=131072

# ── AgentMail (Phase 1 email I/O) ─────────────────────────────
AGENTMAIL_API_KEY=your_agentmail_api_key
# Svix-compatible webhook signing secret (format: whsec_<base64>)
AGENTMAIL_WEBHOOK_SECRET=whsec_your_svix_secret_here

# ── Neo4j (Graph Database) ────────────────────────────────────
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=praxis_dev_password

# ── Qdrant (Vector Database) ───────────────────────────────────
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=praxis_dev_api_key

# ── PostgreSQL (LangGraph Checkpointing) ──────────────────────
POSTGRES_DSN=postgresql://praxis:praxis_dev_password@127.0.0.1:5432/praxis

# ── v0.2.0 additions ─────────────────────────────────────────────
# AgentMail inbox ID (required for attachment downloads in some flows)
AGENTMAIL_INBOX_ID=

# Admin token for /admin/* endpoints and the TUI. Must be >= 32 chars in production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PRAXIS_ADMIN_TOKEN=

# Tool protocol: "native" (LangChain tool-calling, default) or "legacy" (TOOL:/FINAL: text)
TOOL_PROTOCOL=native

# Per-sender reply style
SENDER_STYLE_ENABLED=true
DEFAULT_TONE=professional
DEFAULT_SIGNATURE=— PRAXIS

# URL the TUI uses to reach the FastAPI app
PRAXIS_API_URL=http://localhost:8000

# ── Auto-Healing Recovery Agent ───────────────────────────────────
# Background worker that detects tool failures, diagnoses root cause,
# and applies idempotent recovery actions. Disable with RECOVERY_ENABLED=false.
RECOVERY_ENABLED=true
RECOVERY_POLL_INTERVAL_SECONDS=10
RECOVERY_MAX_RETRIES=3
RECOVERY_RATE_LIMIT_SECONDS=5.0
RECOVERY_EVENTS_PATH=logs/recovery_events.jsonl
RECOVERY_QUEUE_MAX_SIZE=500
