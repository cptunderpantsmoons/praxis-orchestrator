# ── PRAXIS v2.0 Environment Configuration ────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit the .env file with real secrets.

# ── Application ──────────────────────────────────────────────────────
APP_NAME=PRAXIS
APP_VERSION=0.1.0
DEBUG=false

# ── Umans API ────────────────────────────────────────────────────────
# Base URL for the Umans inference API
UMANS_API_BASE_URL=https://api.umans.ai
# API key for authentication (obtain from Umans Enterprise Console)
UMANS_API_KEY=

# ── AgentMail / Svix Webhook ─────────────────────────────────────────
# Svix-compatible webhook signing secret (starts with whsec_)
# Generate in the AgentMail dashboard or via: openssl rand -base64 24
SVIX_WEBHOOK_SECRET=

# ── Neo4j (Graph Database) ───────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=praxis_dev_password

# ── Qdrant (Vector Database) ─────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=praxis_dev_api_key

# ── PostgreSQL (LangGraph Checkpointing) ────────────────────────────
POSTGRES_DSN=postgresql://praxis:praxis_dev_password@localhost:5432/praxis

# ── Concurrency Limits ───────────────────────────────────────────────
# Kimi (umans-coder) — max concurrent API calls
KIMI_CONCURRENCY_LIMIT=4
# GLM (umans-glm-5.2) — max concurrent API calls
GLM_CONCURRENCY_LIMIT=4
# Qwen (umans-flash) — max concurrent API calls
QWEN_CONCURRENCY_LIMIT=8
